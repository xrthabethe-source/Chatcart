{
  "name": "chatcart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant WhatsApp-first commerce platform with provider-based South African delivery (PEP/PAXI, The Courier Guy, same-day, seller collection).",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p ${PORT:-3100}",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:local": "node --env-file=.env.test --experimental-strip-types --test --test-concurrency=1 'src/**/*.test.ts'",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "postinstall": "node node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "15.5.23",
    "prisma": "^6.16.2",
    "react": "19.1.8",
    "react-dom": "19.1.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.6"
  }
}
