DATABASE_URL="postgresql://shop_dev:shop_dev@localhost:5432/chatcart_dev"
# "development" relaxes Secure cookies for http://localhost.
APP_ENV=development
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts per-seller
# courier credentials at rest. Rotating it invalidates stored credentials.
DELIVERY_CREDENTIALS_KEY=""
# Shared secret for POST /api/v1/delivery/tracking/sync (cron) — sent as
# "Authorization: Bearer <secret>".
CRON_SECRET=""
# Public base URL used in payment links and tracking messages.
APP_BASE_URL="http://localhost:3000"
# Comma-separated seller login emails allowed to link WhatsApp numbers
# and import the PAXI Point directory.
PLATFORM_ADMIN_EMAILS=""
# WhatsApp (Meta Cloud API) — see docs/deploy.md. Without an access
# token, outbound messages are only logged.
WHATSAPP_META_ACCESS_TOKEN=""
WHATSAPP_META_APP_SECRET=""
WHATSAPP_META_VERIFY_TOKEN=""
# Language code your message templates were approved in ("en" or "en_US").
WHATSAPP_TEMPLATE_LANGUAGE="en"
# Phone number ID of the shared Chatcart WhatsApp number. Customer updates
# and new-order alerts are sent from it for shops whose own number isn't
# connected to the API yet.
WHATSAPP_PLATFORM_PHONE_ID=""
# "Connect my WhatsApp" (Meta Embedded Signup) — see docs/deploy.md 2.7.
# The app id is public (it's used by the browser); the configuration id
# comes from Facebook Login for Business → Configurations.
META_APP_ID=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# The public website (e.g. built in Lovable) — policy pages are linked
# from checkout. With it set, this app's "/" goes to seller login.
PUBLIC_SITE_URL="https://chatcart.co.za"
